# Copy to .env for docker compose / local
POSTGRES_PASSWORD=clubit
POSTGRES_PORT=5433
API_PORT=3000
WEB_PORT=8080
NODE_ENV=development

# REQUIRED — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-output-here-xx
JWT_REFRESH_SECRET=replace-with-different-openssl-rand-hex-32-yy
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4321

# Browser → API. Prefer same-origin relative path so HttpOnly cookies work.
# Dev (Vite proxy) / Docker (nginx proxy): /api/v1
# Cross-origin only if you must (mobile, external): http://localhost:3000/api/v1
PUBLIC_API_URL=/api/v1

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Optional SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ITCLUB <noreply@clubit.local>"

# Cloudflare Turnstile
# TURNSTILE_SECRET_KEY=
# PUBLIC_TURNSTILE_SITE_KEY=

# Integrations (required in production for GitHub webhook)
# GITHUB_WEBHOOK_SECRET=
# DISCORD_WEBHOOK_URL=
