---
import AuthLayout from "../../layouts/AuthLayout.astro";
import ResetPasswordForm from "../../components/auth/ResetPasswordForm";

const email = Astro.url.searchParams.get("email") ?? "";
---

<AuthLayout
  title="Set New Password"
  step={0}
  panelQuote="Buat password baru yang kuat minimal 8 karakter."
  panelAuthor="Security"
  panelRole="Account recovery"
  image="/auth/panel-3.svg"
>
  <ResetPasswordForm client:only="react" email={email} />
</AuthLayout>
