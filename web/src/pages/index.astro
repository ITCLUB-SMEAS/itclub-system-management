---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home">
  <script is:inline>
    // Cookie session: profile in localStorage; tokens are HttpOnly
    const user = localStorage.getItem("clubit_user") || localStorage.getItem("user");
    window.location.replace(user ? "/dashboard" : "/auth/sign-in");
  </script>
  <div class="flex min-h-screen items-center justify-center bg-brand-50">
    <p class="text-sm text-brand-700 font-medium">Loading ITCLUB...</p>
  </div>
</BaseLayout>
