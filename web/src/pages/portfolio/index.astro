---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchShowcase } from "../../lib/public-api";

let showcase: Awaited<ReturnType<typeof fetchShowcase>> | null = null;
let loadError = "";
try {
  showcase = await fetchShowcase();
} catch {
  loadError = "Gagal memuat showcase. Pastikan API berjalan.";
}
---

<BaseLayout title="Showcase ITCLUB">
  <div class="min-h-screen bg-brand-50">
    <header class="border-b border-brand-100 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="/portfolio" class="flex items-center gap-2">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-500 text-sm font-bold text-white">
            IT
          </div>
          <div>
            <p class="text-sm font-semibold text-slate-900">ITCLUB</p>
            <p class="text-[11px] text-slate-400">Public Showcase</p>
          </div>
        </a>
        <div class="flex gap-2 text-sm">
          <a href="/recruitment" class="rounded-full border border-brand-200 px-3 py-1.5 font-medium text-brand-700 hover:bg-brand-50">
            Daftar
          </a>
          <a href="/auth/sign-in" class="rounded-full bg-brand-600 px-3 py-1.5 font-medium text-white hover:bg-brand-700">
            Login
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-10">
      <section class="mb-10 rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 px-8 py-12 text-white shadow-lg shadow-brand-200">
        <p class="text-sm font-medium text-brand-100">Ekstrakurikuler IT</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
          Showcase ITCLUB
        </h1>
        <p class="mt-3 max-w-xl text-sm text-brand-100">
          Lihat anggota, prestasi, dan kegiatan — auto-generate dari data internal.
        </p>
      </section>

      {loadError && (
        <div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
          {loadError}
        </div>
      )}

      {showcase && (
        <>
          <section class="mb-12">
            <div class="mb-4 flex items-end justify-between">
              <h2 class="text-xl font-semibold text-slate-900">Anggota</h2>
              <span class="text-sm text-slate-400">{showcase.members.length} orang</span>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {showcase.members.map((m) => (
                <a
                  href={`/portfolio/${m.id}`}
                  class="rounded-2xl border border-brand-100 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow-md"
                >
                  <div class="mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700">
                    {m.fullName.slice(0, 2).toUpperCase()}
                  </div>
                  <h3 class="font-semibold text-slate-900">{m.fullName}</h3>
                  {m.interests?.length > 0 && (
                    <div class="mt-2 flex flex-wrap gap-1">
                      {m.interests.slice(0, 3).map((i) => (
                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-slate-600">
                          {i}
                        </span>
                      ))}
                    </div>
                  )}
                  {m.badges?.length > 0 && (
                    <p class="mt-3 text-xs text-brand-600">
                      {m.badges.map((b) => b.badge.name).join(" · ")}
                    </p>
                  )}
                </a>
              ))}
              {!showcase.members.length && (
                <p class="text-sm text-slate-400 sm:col-span-2 lg:col-span-3">Belum ada anggota publik</p>
              )}
            </div>
          </section>

          <section class="mb-12 grid gap-6 lg:grid-cols-2">
            <div>
              <h2 class="mb-4 text-xl font-semibold text-slate-900">Prestasi</h2>
              <ul class="space-y-3">
                {showcase.achievements.map((a) => (
                  <li class="rounded-2xl border border-brand-100 bg-white px-4 py-3 shadow-sm">
                    <p class="font-medium text-slate-900">{a.title}</p>
                    <p class="text-xs text-slate-400">
                      {a.rank ?? "—"}
                      {a.event ? ` · ${a.event.title}` : ""}
                    </p>
                  </li>
                ))}
                {!showcase.achievements.length && (
                  <li class="text-sm text-slate-400">Belum ada prestasi</li>
                )}
              </ul>
            </div>
            <div>
              <h2 class="mb-4 text-xl font-semibold text-slate-900">Event terbaru</h2>
              <ul class="space-y-3">
                {showcase.events.map((e) => (
                  <li class="rounded-2xl border border-brand-100 bg-white px-4 py-3 shadow-sm">
                    <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-semibold uppercase text-brand-700">
                      {e.type}
                    </span>
                    <p class="mt-1 font-medium text-slate-900">{e.title}</p>
                    <p class="text-xs text-slate-400">
                      {new Date(e.startDate).toLocaleDateString("id-ID")}
                    </p>
                  </li>
                ))}
                {!showcase.events.length && (
                  <li class="text-sm text-slate-400">Belum ada event</li>
                )}
              </ul>
            </div>
          </section>
        </>
      )}
    </main>

    <footer class="border-t border-brand-100 bg-white py-6 text-center text-xs text-slate-400">
      ITCLUB Ekskul · Portfolio auto-generate
    </footer>
  </div>
</BaseLayout>
