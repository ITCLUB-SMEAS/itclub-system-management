{
  "name": "clubit",
  "private": true,
  "version": "0.1.0",
  "description": "ITCLUB Ekskul Management — monorepo (api + web)",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w api && npm run build -w web",
    "test": "npm run test -w api",
    "ci": "npm run ci -w api && npm run ci -w web",
    "db:migrate": "npm run prisma:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "prisma:generate": "npm run prisma:generate -w api"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
