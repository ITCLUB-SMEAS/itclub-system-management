DATABASE_URL="postgresql://clubit:clubit@localhost:5433/clubit?schema=public"

# REQUIRED — openssl rand -hex 32
JWT_SECRET="replace-with-openssl-rand-hex-32-output-here-xx"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-different-openssl-rand-hex-32-yy"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:4321,http://127.0.0.1:4321"
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=20

# Cloudflare Turnstile (optional). Empty = captcha skipped in dev.
# TURNSTILE_SECRET_KEY=

# Integrations — required when NODE_ENV=production for GitHub webhook
# GITHUB_WEBHOOK_SECRET=
# DISCORD_WEBHOOK_URL=

# Daily 08:00 cron (activity H-1, event H-1, task deadline, inventory overdue)
# REMINDERS_CRON=false

# Optional SMTP. Empty = stub + devCode / temp password in dev responses only.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ITCLUB <noreply@clubit.local>"
