DATABASE_URL="postgresql://clubit:clubit@localhost:5433/clubit?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-production-refresh"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:4321,http://127.0.0.1:4321"
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=20

# Cloudflare Turnstile (optional). Empty = captcha skipped in dev.
# Dashboard: https://dash.cloudflare.com → Turnstile → create widget
# TURNSTILE_SECRET_KEY=
# PUBLIC_TURNSTILE_SITE_KEY goes in web/.env only

# Integrations
# GITHUB_WEBHOOK_SECRET= # HMAC for POST /integrations/github/webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional real email (nodemailer). Leave empty = stub + devCode in response.
# Gmail: enable 2FA → App Password. Mailtrap: use sandbox host.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ITCLUB <noreply@clubit.local>"
