generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum MemberStatus {
  ACTIVE
  ALUMNI
  INACTIVE
}

enum RoleName {
  ANGGOTA
  KETUA
  WAKIL_KETUA
  SEKRETARIS
  BENDAHARA
  KEPALA_DIVISI
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum NotificationType {
  ANNOUNCEMENT
  DEADLINE
  EVENT_REMINDER
  APPROVAL_RESULT
  FEEDBACK
}

enum LoanStatus {
  REQUESTED
  APPROVED
  BORROWED
  RETURNED
  REJECTED
}

enum ElectionStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AttendanceMethod {
  QR
  MANUAL
}

// ============ CORE: USER, MEMBER, ORG ============

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  username       String          @unique
  passwordHash   String
  member         Member?
  notifications  Notification[]
  deviceTokens   DeviceToken[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model DeviceToken {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token            String   @unique
  platform         String
  /// SHA-256 hex of client biometric secret — never store raw
  biometricKeyHash String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([biometricKeyHash])
}

// ============ AUDIT ============

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model MembershipPeriod {
  id               String            @id @default(cuid())
  name             String
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean           @default(false)
  members          MemberPeriod[]
  elections        Election[]
  transactions     Transaction[]
  evaluations      Evaluation[]
  financialReports FinancialReport[]
}

model Division {
  id                String             @id @default(cuid())
  name              String
  description       String?
  memberPeriods     MemberPeriod[]
  tasks             Task[]
  learningPaths     LearningPath[]
  learningResources LearningResource[]
}

model Member {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  className      String?
  batchYear      Int?
  interests      String[]
  status         MemberStatus   @default(ACTIVE)
  approvalStatus ApprovalStatus @default(PENDING)

  periods             MemberPeriod[]
  attendances         Attendance[]
  submissions         Submission[]
  eventRegs           EventRegistration[]
  transactionsLogged  Transaction[]
  badges              MemberBadge[]
  certificates        Certificate[]
  votes               Vote[]
  pollVotes           PollVote[]
  candidacies         ElectionCandidate[]
  loans               InventoryLoan[]
  assignedTasks       Task[]             @relation("TaskAssignee")
  evaluationsGiven    Evaluation[]       @relation("EvaluationGiver")
  peerReviewsGiven    PeerReview[]       @relation("ReviewerRelation")
  peerReviewsReceived PeerReview[]       @relation("RevieweeRelation")
  mentorOf            MentorAssignment[] @relation("MentorRelation")
  menteeOf            MentorAssignment[] @relation("MenteeRelation")
  feedbackGiven       Feedback[]         @relation("FeedbackGiver")
  achievements        Achievement[]
  learningProgress    LearningProgress[]

  createdAt DateTime @default(now())
}

model MemberPeriod {
  id         String           @id @default(cuid())
  memberId   String
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  periodId   String
  period     MembershipPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  divisionId String?
  division   Division?        @relation(fields: [divisionId], references: [id])
  role       RoleName         @default(ANGGOTA)

  @@unique([memberId, periodId])
  @@index([periodId])
  @@index([divisionId])
}

// ============ PRESENSI & KEGIATAN ============

model Activity {
  id               String       @id @default(cuid())
  title            String
  description      String?
  location         String?
  latitude         Float?
  longitude        Float?
  /// meters; null = geofence off
  geofenceRadiusM  Int?
  qrToken          String       @unique @default(cuid())
  qrTokenExpiresAt DateTime?
  startTime        DateTime
  endTime          DateTime
  reminderSentAt   DateTime?
  attendances      Attendance[]
}

model Attendance {
  id          String           @id @default(cuid())
  activityId  String
  activity    Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkedInAt DateTime         @default(now())
  method      AttendanceMethod @default(MANUAL)
  latitude    Float?
  longitude   Float?

  @@unique([activityId, memberId])
  @@index([memberId])
}

// ============ EVENT & PRESTASI ============

model Event {
  id                String              @id @default(cuid())
  title             String
  description       String?
  type              String
  location          String?
  capacity          Int?
  registrationOpen  Boolean             @default(true)
  startDate         DateTime
  endDate           DateTime?
  reminderSentAt    DateTime?
  registrations     EventRegistration[]
  achievements      Achievement[]
  galleries         GalleryItem[]
}

model EventRegistration {
  id       String         @id @default(cuid())
  eventId  String
  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String
  member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status   ApprovalStatus @default(PENDING)

  @@unique([eventId, memberId])
  @@index([memberId])
}

model GalleryItem {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
}

// ============ PROJECT & TUGAS ============

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  tasks       Task[]
  peerReviews PeerReview[]
  createdAt   DateTime     @default(now())
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  divisionId  String?
  division    Division?    @relation(fields: [divisionId], references: [id])
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  assigneeId  String?
  assignee    Member?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  submissions Submission[]
  dueDate     DateTime?

  @@index([projectId])
  @@index([assigneeId])
}

model Submission {
  id                String     @id @default(cuid())
  taskId            String
  task              Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId          String
  member            Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  repoUrl           String?
  fileUrl           String?
  demoUrl           String?
  githubCommitCount Int?
  submittedAt       DateTime   @default(now())
  feedback          Feedback[]

  @@index([taskId])
  @@index([memberId])
}

model Feedback {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     Member     @relation("FeedbackGiver", fields: [reviewerId], references: [id])
  content      String
  createdAt    DateTime   @default(now())
}

model MentorAssignment {
  id       String @id @default(cuid())
  mentorId String
  mentor   Member @relation("MentorRelation", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId String
  mentee   Member @relation("MenteeRelation", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([mentorId, menteeId])
}

// ============ KEUANGAN ============

model Transaction {
  id           String            @id @default(cuid())
  type         TransactionType
  amount       Decimal           @db.Decimal(12, 2)
  description  String
  category     String?
  periodId     String?
  period       MembershipPeriod? @relation(fields: [periodId], references: [id])
  recordedById String
  recordedBy   Member            @relation(fields: [recordedById], references: [id])
  occurredAt   DateTime          @default(now())
  voidedAt     DateTime?
  voidedById   String?

  @@index([periodId])
  @@index([recordedById])
  @@index([voidedAt])
}

model FinancialReport {
  id          String            @id @default(cuid())
  periodId    String?
  period      MembershipPeriod? @relation(fields: [periodId], references: [id])
  income      Decimal           @db.Decimal(14, 2)
  expense     Decimal           @db.Decimal(14, 2)
  balance     Decimal           @db.Decimal(14, 2)
  txCount     Int
  generatedBy String?
  note        String?
  createdAt   DateTime          @default(now())

  @@index([periodId])
  @@index([createdAt])
}

// ============ KOMUNIKASI ============

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

// ============ ACHIEVEMENT & GAMIFIKASI ============

model Badge {
  id          String        @id @default(cuid())
  name        String
  description String?
  iconUrl     String?
  members     MemberBadge[]
}

model MemberBadge {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([memberId, badgeId])
}

model Achievement {
  id          String  @id @default(cuid())
  eventId     String?
  event       Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  memberId    String?
  member      Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  title       String
  rank        String?
  description String?

  @@index([memberId])
}

model Certificate {
  id       String   @id @default(cuid())
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title    String
  fileUrl  String?
  issuedAt DateTime @default(now())

  @@index([memberId])
}

// ============ LEARNING & KNOWLEDGE BASE ============

model LearningResource {
  id             String            @id @default(cuid())
  title          String
  type           String
  url            String
  description    String?
  sortOrder      Int               @default(0)
  divisionId     String?
  division       Division?         @relation(fields: [divisionId], references: [id])
  learningPathId String?
  learningPath   LearningPath?     @relation(fields: [learningPathId], references: [id])
  progress       LearningProgress[]
  createdAt      DateTime          @default(now())

  @@index([learningPathId])
  @@index([divisionId])
}

model LearningPath {
  id          String             @id @default(cuid())
  name        String
  level       String
  description String?
  sortOrder   Int                @default(0)
  divisionId  String?
  division    Division?          @relation(fields: [divisionId], references: [id])
  resources   LearningResource[]
}

model LearningProgress {
  id         String           @id @default(cuid())
  memberId   String
  member     Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resourceId String
  resource   LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  completed  Boolean          @default(true)
  completedAt DateTime        @default(now())

  @@unique([memberId, resourceId])
  @@index([memberId])
}

// ============ REKRUTMEN ============

enum RecruitmentStage {
  FORM
  TEST
  INTERVIEW
  ANNOUNCEMENT
}

model RecruitmentApplication {
  id                 String           @id @default(cuid())
  fullName           String
  email              String
  className          String?
  interestNotes      String?
  divisionPreference String?
  stage              RecruitmentStage @default(FORM)
  status             ApprovalStatus   @default(PENDING)
  /// JSON checklist: { "akun": true, "intro": false, ... }
  onboarding         Json?
  notes              String?
  appliedAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status])
  @@index([stage])
}

// ============ PEMILU & VOTING ============

model Election {
  id          String              @id @default(cuid())
  periodId    String
  period      MembershipPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      ElectionStatus      @default(DRAFT)
  endsAt      DateTime?
  candidates  ElectionCandidate[]
  votes       Vote[]
}

model ElectionCandidate {
  id         String   @id @default(cuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  votes      Vote[]

  @@unique([electionId, memberId])
}

model Vote {
  id          String            @id @default(cuid())
  electionId  String
  election    Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   ElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voterId     String
  voter       Member            @relation(fields: [voterId], references: [id], onDelete: Cascade)
  votedAt     DateTime          @default(now())

  @@unique([electionId, voterId])
}

model Poll {
  id        String       @id @default(cuid())
  question  String
  closed    Boolean      @default(false)
  endsAt    DateTime?
  options   PollOption[]
  votes     PollVote[]
  createdAt DateTime     @default(now())
}

model PollOption {
  id         String     @id @default(cuid())
  pollId     String
  poll       Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label      String
  votesCount Int        @default(0)
  votes      PollVote[]
}

model PollVote {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voterId  String
  voter    Member     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  votedAt  DateTime   @default(now())

  @@unique([pollId, voterId])
}

// ============ PEMINJAMAN INVENTARIS ============

model InventoryItem {
  id           String          @id @default(cuid())
  name         String
  condition    String?
  quantity     Int             @default(1)
  serialNumber String?
  notes        String?
  loans        InventoryLoan[]
  createdAt    DateTime        @default(now())
}

model InventoryLoan {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status     LoanStatus    @default(REQUESTED)
  notes      String?
  dueDate    DateTime?
  borrowedAt DateTime?
  returnedAt DateTime?

  @@index([memberId])
  @@index([status])
  @@index([dueDate])
}

// ============ EVALUASI & FEEDBACK ============

model Evaluation {
  id         String           @id @default(cuid())
  periodId   String
  period     MembershipPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  giverId    String
  giver      Member           @relation("EvaluationGiver", fields: [giverId], references: [id], onDelete: Cascade)
  targetRole String
  score      Int
  comment    String?
  createdAt  DateTime         @default(now())

  @@unique([periodId, giverId, targetRole])
  @@index([periodId])
}

model PeerReview {
  id         String   @id @default(cuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reviewerId String
  reviewer   Member   @relation("ReviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId String
  reviewee   Member   @relation("RevieweeRelation", fields: [revieweeId], references: [id], onDelete: Cascade)
  score      Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([revieweeId])
  @@index([reviewerId])
}
